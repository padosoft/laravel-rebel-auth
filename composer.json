{
  "name": "padosoft/laravel-rebel-auth",
  "description": "Meta-package for the padosoft/laravel-rebel-* enterprise authentication control plane: passwordless email-OTP, passkey-first, risk-based step-up with PSD2/SCA, channels, sessions, recovery, anomaly detection and a web admin panel — installs and ties the whole suite together.",
  "license": "MIT",
  "keywords": [
    "laravel",
    "authentication",
    "security",
    "padosoft",
    "rebel"
  ],
  "homepage": "https://github.com/padosoft/laravel-rebel-auth",
  "authors": [
    {
      "name": "Padosoft",
      "email": "support@padosoft.com",
      "homepage": "https://www.padosoft.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "spatie/laravel-package-tools": "^1.92",
    "padosoft/laravel-rebel-core": "^0.1",
    "padosoft/laravel-rebel-email-otp": "^0.1",
    "padosoft/laravel-rebel-step-up": "^0.1",
    "padosoft/laravel-rebel-bridge-fortify": "^0.1",
    "padosoft/laravel-rebel-channels": "^0.1",
    "padosoft/laravel-rebel-admin-api": "^0.1",
    "padosoft/laravel-rebel-admin": "^0.1",
    "padosoft/laravel-rebel-sessions": "^0.1",
    "padosoft/laravel-rebel-recovery": "^0.1",
    "padosoft/laravel-rebel-ai-guard": "^0.1"
  },
  "suggest": {
    "padosoft/laravel-rebel-channel-twilio": "Twilio Verify provider (SMS/WhatsApp/voice) for laravel-rebel-channels.",
    "padosoft/laravel-rebel-channel-vonage": "Vonage channel provider for laravel-rebel-channels.",
    "padosoft/laravel-rebel-channel-bird": "Bird (MessageBird) channel provider for laravel-rebel-channels.",
    "padosoft/laravel-rebel-channel-telegram": "Telegram channel provider for laravel-rebel-channels.",
    "padosoft/laravel-rebel-channel-discord": "Discord channel provider for laravel-rebel-channels.",
    "padosoft/laravel-rebel-bridge-passkeys": "Passkey/WebAuthn bridge.",
    "padosoft/laravel-rebel-bridge-spatie-otp": "Bridge to spatie/laravel-one-time-passwords.",
    "padosoft/laravel-rebel-bridge-laragear-2fa": "Bridge to laragear/two-factor.",
    "padosoft/laravel-rebel-bridge-otpz": "Bridge to the otpz package.",
    "padosoft/laravel-rebel-bot-protection": "Bot-protection (CAPTCHA/Turnstile) bridge."
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.18",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Padosoft\\Rebel\\Auth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Padosoft\\Rebel\\Auth\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Padosoft\\Rebel\\Auth\\RebelAuthServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "pest",
    "phpstan": "phpstan analyse --memory-limit=512M",
    "pint": "pint",
    "check": [
      "pint --test",
      "@phpstan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
